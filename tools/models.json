  "entries": [
    {
      "group": "选择与决策",
      "header": "默认模型",
      "rows": [
        {
          "when": "\"我该不该跳槽/转行\"",
          "level": "L3",
          "models": "#9决策矩阵 + #4反脆弱 + #27可逆性"
        },
        {
          "when": "\"两个offer怎么选\"",
          "level": "L3",
          "models": "#9决策矩阵 + #27可逆性"
        },
        {
          "when": "\"要不要创业\"",
          "level": "L3",
          "models": "#4反脆弱 + #73选择权 + #29前置思考"
        },
        {
          "when": "\"要不要继续投\"",
          "level": "L3+BC",
          "models": "#1沉没成本 + #16边际"
        },
        {
          "when": "\"要不要止损/坚持\"",
          "level": "L3",
          "models": "#1沉没 + #12复利"
        },
        {
          "when": "\"这个项目多久能做完/预算多少\"",
          "level": "L2",
          "models": "#77规划谬误 + #67参考类预测 + #60均值回归"
        },
        {
          "when": "\"这笔钱该投多少\"",
          "level": "L3",
          "models": "#68凯利公式 + #72安全边际 + #25期望值"
        },
        {
          "when": "\"这个报价/收购价合理吗\"",
          "level": "L2",
          "models": "#72安全边际 + #70机会成本"
        }
      ]
    },
    {
      "group": "理解与分析",
      "header": "默认模型",
      "rows": [
        {
          "when": "\"为什么会这样/底层逻辑\"",
          "level": "L2",
          "models": "#2逆向 + #23二阶思维"
        },
        {
          "when": "\"本质是什么\"",
          "level": "L3",
          "models": "第一性原理 + #4反脆弱"
        },
        {
          "when": "\"有什么影响\"",
          "level": "L2",
          "models": "#23二阶思维"
        },
        {
          "when": "\"指标涨了但业务没变好\"",
          "level": "L2",
          "models": "#74古德哈特 + #75存量与流量"
        }
      ]
    },
    {
      "group": "策略与行动",
      "header": "默认模型",
      "rows": [
        {
          "when": "\"怎么做/如何提高效率\"",
          "level": "L2",
          "models": "#3二八 + MVP（库外）"
        },
        {
          "when": "\"资源有限,先做什么\"",
          "level": "L2",
          "models": "#3二八 + #70机会成本"
        },
        {
          "when": "\"要不要试新渠道/新方向\"",
          "level": "L2",
          "models": "#69探索-利用 + #73选择权"
        },
        {
          "when": "\"谈判策略\"",
          "level": "L3+BC",
          "models": "#71谈判底线 + #14博弈论 + #5锚定"
        },
        {
          "when": "\"竞争策略\"",
          "level": "L3",
          "models": "#13护城河 + #14博弈论"
        }
      ]
    },
    {
      "group": "自我与成长",
      "header": "默认模型",
      "rows": [
        {
          "when": "\"我适合做什么\"",
          "level": "L3",
          "models": "#62甜蜜点 + #10成长型"
        },
        {
          "when": "\"怀疑自己行不行\"",
          "level": "L2",
          "models": "BC#19冒充者 + #10成长型"
        },
        {
          "when": "\"我为什么一直给自己找理由\"",
          "level": "L2",
          "models": "#76认知失调 + BC#14动机性推理"
        },
        {
          "when": "\"复盘上个季度\"",
          "level": "L3",
          "models": "#12复利 + #74古德哈特"
        }
      ]
    },
    {
      "group": "日常生活（普通人高频场景）",
      "header": "默认模型/偏差",
      "rows": [
        {
          "when": "\"该不该分手/结婚\"",
          "level": "L3",
          "models": "#4反脆弱 + #27可逆性 + BC#5损失厌恶"
        },
        {
          "when": "\"要不要生孩子\"",
          "level": "L3",
          "models": "#29前置思考 + #4反脆弱"
        },
        {
          "when": "\"孩子不听话/叛逆期怎么办\"",
          "level": "L2",
          "models": "#55换位思考 + #50权威偏见防护"
        },
        {
          "when": "\"怎么和伴侣沟通\"",
          "level": "L2",
          "models": "#55换位思考 + #8框架效应"
        },
        {
          "when": "\"该不该借钱给亲戚\"",
          "level": "L2",
          "models": "#1沉没成本 + #27可逆性"
        },
        {
          "when": "\"父母催婚怎么应对\"",
          "level": "L2",
          "models": "BC#6从众(文化适配) + #55换位思考"
        },
        {
          "when": "\"最近很焦虑/睡不好\"",
          "level": "L1",
          "models": "建议专业帮助 + BC#7过度自信(对未来的判断)"
        },
        {
          "when": "\"怎么存钱/要不要买保险\"",
          "level": "L2",
          "models": "BC#32双曲贴现 + #72安全边际"
        },
        {
          "when": "\"要不要贷款/提前消费\"",
          "level": "L2",
          "models": "#70机会成本 + BC#31心理账户"
        },
        {
          "when": "\"今天吃什么/怎么省钱\"",
          "level": "L0",
          "models": "直接答 + 一句增值"
        },
        {
          "when": "\"该不该在大城市留下来\"",
          "level": "L3",
          "models": "#4反脆弱 + #62甜蜜点 + #16边际"
        },
        {
          "when": "\"怎么判断一个人值不值得深交\"",
          "level": "L2",
          "models": "BC#25光环效应 + BC#26基本归因"
        }
      ]
    },
    {
      "group": "偏差检查入口",
      "header": "默认偏差",
      "rows": [
        {
          "when": "\"帮我看看这个决定\"",
          "level": "L3",
          "models": "BC#1确认 + BC#2锚定 + BC#7过度自信"
        },
        {
          "when": "\"我刚做了投资决定\"",
          "level": "L3",
          "models": "BC#5损失 + BC#29沉没 + BC#1确认"
        },
        {
          "when": "\"团队一致同意,但我感觉不对\"",
          "level": "L3",
          "models": "BC#23群体 + BC#6从众"
        },
        {
          "when": "\"我100%确定\"",
          "level": "L3",
          "models": "BC#7过度 + BC#1确认 + BC#36基础概率"
        },
        {
          "when": "\"所有/每个/总是/绝不\"",
          "level": "L2",
          "models": "BC#3幸存者 + BC#36基础概率"
        },
        {
          "when": "\"每次都说下季度就能做完\"",
          "level": "L2",
          "models": "#77规划谬误 + BC#7过度自信"
        }
      ]
    }
  ],
